// incnet database schema. Apply with `npm run db:push` (or `prisma migrate deploy` once migrations exist).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false) // platform operator: the first account on a fresh install
  createdAt    DateTime @default(now())

  memberships Member[]
  invitesSent Invite[]   @relation("InviteCreator")
  auditLogs   AuditLog[]
}

/// A business that runs one or more hotspots. Everything below belongs to a workspace.
model Workspace {
  id           String   @id @default(cuid())
  name         String
  plan         String   @default("free") // cloud only: free | pro. Self-hosted installs ignore plans.
  currency     String   @default("TZS")
  brandColor   String   @default("#17b8a8")
  supportPhone String?
  welcomeText  String?
  timezone     String   @default("Africa/Dar_es_Salaam")
  isDemo       Boolean  @default(false) // a throwaway workspace from "Try the live demo"

  // Captive portal design
  portalTheme    String  @default("modern") // modern | minimal | bold | classic | photo
  portalLogo     String? // small image as a data: URL
  portalBg       String? // background photo as a data: URL (photo theme)
  portalHeadline String?
  termsText      String?
  portalLang     String  @default("en") // en | sw

  // Voucher print design
  voucherTemplate String @default("classic") // classic | ticket | minimal | card
  voucherOptions  Json   @default("{}")

  // Mobile money. Keys are stored encrypted with APP_SECRET.
  paymentProvider  String  @default("none") // none | incpesa | snippe | test
  paymentKeyEnc    String?
  paymentSecretEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Member[]
  sites    Site[]
  packages Package[]
  accesses Access[]
  batches  VoucherBatch[]
  payments Payment[]
  invites  Invite[]
  auditLogs AuditLog[]
}

model Member {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("owner") // owner | admin | manager | cashier | viewer (see lib/permissions.ts)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

/// One venue = one MikroTik router.
model Site {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  kind        String    @default("mikrotik") // mikrotik | opennds (Raspberry Pi / OpenWrt) | simulated
  slug        String    @unique // public portal address: /p/<slug>
  tokenHash   String    @unique // router credential (inr_...), looked up by hash
  tokenEnc    String // the same token, encrypted, so the setup script can be shown again
  ports       String    @default("ether5") // MikroTik: hotspot ports. openNDS: the gateway interface (e.g. wlan0, br-lan)
  subnet      Int       @default(50) // hotspot network is 10.5.<subnet>.0/24

  // Reported by the router on each sync.
  lastSeenAt    DateTime?
  appliedCursor BigInt    @default(0) // the router has applied every change up to this time (ms)
  routerVersion String?
  routerBoard   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accesses Access[]
  payments Payment[]
  packages Package[]
  batches  VoucherBatch[]

  @@index([workspaceId])
}

model Package {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId          String? // null = sold at every router
  site            Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  price           Int
  durationMinutes Int
  downKbps        Int       @default(5000)
  upKbps          Int       @default(2000)
  dataLimitMb     Int? // null = unlimited
  devices         Int       @default(1) // devices that may share one code
  active          Boolean   @default(true)
  sort            Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accesses Access[]
  batches  VoucherBatch[]
  payments Payment[]

  @@index([workspaceId])
}

/// A code that unlocks the hotspot: a printed voucher or one issued after a mobile money payment.
/// The router only holds active codes; incnet pushes them on the next sync.
model Access {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId      String? // null = valid at every site in the workspace
  site        Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  packageId   String
  package     Package       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  batchId     String?
  batch       VoucherBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  code        String
  kind        String        @default("voucher") // voucher | payment
  status      String        @default("unused") // unused | active | expired | revoked
  phone       String?
  mac         String?
  ip          String? // the phone's address on the hotspot (openNDS authorises by IP)
  activeSiteId String? // the site where the code was first used
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment Payment?

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model VoucherBatch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  count       Int
  note        String?
  createdAt   DateTime  @default(now())

  accesses Access[]

  @@index([workspaceId])
}

model Payment {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteId        String?
  site          Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  packageId     String
  package       Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  accessId      String?   @unique
  access        Access?   @relation(fields: [accessId], references: [id], onDelete: SetNull)
  amount        Int
  phone         String
  mac           String?
  ip            String?
  provider      String
  providerRef   String?
  status        String    @default("pending") // pending | completed | failed | expired | needs_review
  failureReason String?
  checkedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([status])
}

/// A link that lets someone join a workspace with a given role. Shared by the owner; no email server needed.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String
  label       String? // who it is for, e.g. "Asha (front desk)"
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// Who did what, for the team activity log.
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // e.g. vouchers.create, package.save, team.invite
  detail      String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
