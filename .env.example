# ── Required ──────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgresql://incnet:incnet@localhost:5432/incnet
# The public address of this server. Routers and payment providers call it, so it must be reachable from the internet.
APP_URL=https://wifi.example.com
# A long random string (32+ characters). Signs sessions and encrypts payment keys. Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ── Optional ──────────────────────────────────────────────────────
# Let anyone create an account (the first account is always allowed and becomes the owner).
ALLOW_SIGNUP=false
# How often routers check in, in seconds (default 4). Lower = faster login after payment.
ROUTER_SYNC_SECONDS=4
# Time zone for dates in the dashboard.
TZ=Africa/Dar_es_Salaam
# Override the incpesa API address (for testing).
# INCPESA_API_URL=https://incpritech.com/api/incpesa/v1

# ── Hosted (SaaS) mode ────────────────────────────────────────────
# Turns on plans, router limits per plan, open sign-up and the platform page for the first account.
INCNET_CLOUD=false
